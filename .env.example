# ─────────────────────────────────────────────────────────────────────────────
# Kamus Bugis – Environment Variables
# Salin file ini ke .env dan sesuaikan nilainya:
#   cp .env.example .env
# ─────────────────────────────────────────────────────────────────────────────

# ── Apache Jena Fuseki ────────────────────────────────────────────────────────

# URL internal Fuseki (digunakan oleh backend di dalam Docker network)
# JANGAN ubah hostname "fuseki" – itu adalah nama service di docker-compose
FUSEKI_URL=http://fuseki:3030

# Nama dataset Fuseki (harus sama dengan yang dikonfigurasi di entrypoint)
FUSEKI_DATASET=bugis

# Password admin Fuseki (ganti dengan password yang kuat di production!)
ADMIN_PASSWORD=admin

# ── Groq AI (RAG - Tanya AI) ───────────────────────────────────────────────────

# API key dari Groq Console (https://console.groq.com/keys)
# WAJIB diisi agar fitur Tanya AI berfungsi
# Groq gratis dengan rate limit generous (30 req/menit untuk free tier)
GROQ_API_KEY=your_groq_api_key_here

# ─────────────────────────────────────────────────────────────────────────────
# CATATAN KEAMANAN:
#   - Jangan commit file .env ke repository
#   - File .env sudah ada di .gitignore
#   - Gunakan password yang kuat di VPS/production
#   - Dapatkan GROQ_API_KEY gratis di https://console.groq.com/keys
# ─────────────────────────────────────────────────────────────────────────────
