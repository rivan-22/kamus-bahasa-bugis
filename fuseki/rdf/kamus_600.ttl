# 501. saoraja — istana / rumah raja
bugis:saoraja
    rdf:type                      bugis:Nomina ;
    bugis:nomorEntri              501 ;
    bugis:aksaraLontaraq          "ᨔᨕᨚᨑᨍ" ;
    bugis:bentukLatin             "saoraja" ;
    bugis:maknaIndonesia          "istana, rumah raja, kediaman bangsawan" ;
    bugis:maknaInggris            "palace, royal residence, nobleman's dwelling" ;
    bugis:fonetik                 "/sa.o.ra.ja/" ;
    bugis:silabel                 4 ;
    bugis:contohKalimat           "Saoraja maloppe nabangun arung ri tana Bone." ;
    bugis:contohKalimatTerjemahan "Istana besar dibangun oleh raja di tanah Bone." ;
    bugis:jenisMorfologi          "kata majemuk (sao + raja)" ;
    bugis:tingkatFormalitas       "formal" ;
    bugis:frekuensiPenggunaan     "sedang" ;
    bugis:statusKata              "aktif" ;
    bugis:dialek                  "umum" ;
    bugis:sumber                  "OJED" ;
    bugis:diturunkanDari          bugis:akar_saoraja ;
    bugis:berkaitanDengan         bugis:arung ;
    bugis:berkaitanDengan         bugis:wanua ;
    bugis:termasukDomain          bugis:DomainPemerintahan .

