# =============================================================================
# DATA TAMBAHAN KAMUS BAHASA BUGIS — 100 ENTRI RDF TURTLE
# Semantic Web Course — Proyek Akhir
# Domain: Seni & Budaya | Perdagangan & Ekonomi | Hewan & Tumbuhan |
#         Pakaian & Perhiasan | Kata Kerja Lanjut | Kata Sifat Lanjut |
#         Waktu & Bilangan | Peribahasa
# Encoding: UTF-8
# Sumber: OJED (sealang.net/ojed), Wiktionary Bugis
# Entri: 601–700 (melanjutkan dari kamus_600.ttl)
# =============================================================================

@prefix bugis:  <http://example.org/bugis#> .
@prefix rdf:    <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:   <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl:    <http://www.w3.org/2002/07/owl#> .
@prefix xsd:    <http://www.w3.org/2001/XMLSchema#> .


# =============================================================================
# DOMAIN SEMANTIK BARU
# =============================================================================

bugis:DomainSeniLoga
    rdf:type        bugis:DomainSemantik ;
    bugis:namaDomain "seni dan loga" ;
    rdfs:label      "Seni dan Loga"@id ;
    rdfs:comment    "Kata-kata yang berkaitan dengan seni, tenun, ukiran, dan loga tradisional Bugis." .

bugis:DomainHewanTumbuhan
    rdf:type        bugis:DomainSemantik ;
    bugis:namaDomain "hewan dan tumbuhan" ;
    rdfs:label      "Hewan dan Tumbuhan"@id ;
    rdfs:comment    "Kata-kata yang berkaitan dengan dunia fauna dan flora dalam kehidupan Bugis." .

bugis:DomainPerhiasan
    rdf:type        bugis:DomainSemantik ;
    bugis:namaDomain "pakaian dan perhiasan" ;
    rdfs:label      "Pakaian dan Perhiasan"@id ;
    rdfs:comment    "Kata-kata yang berkaitan dengan pakaian adat, perhiasan, dan aksesori Bugis." .

bugis:DomainPerdagangan
    rdf:type        bugis:DomainSemantik ;
    bugis:namaDomain "perdagangan dan ekonomi" ;
    rdfs:label      "Perdagangan dan Ekonomi"@id ;
    rdfs:comment    "Kata-kata yang berkaitan dengan kegiatan jual-beli, niaga, dan perekonomian." .

bugis:DomainPeribahasa
    rdf:type        bugis:DomainSemantik ;
    bugis:namaDomain "peribahasa" ;
    rdfs:label      "Peribahasa"@id ;
    rdfs:comment    "Ungkapan tradisional Bugis yang mengandung makna nasihat atau kiasan." .


