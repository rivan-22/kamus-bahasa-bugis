# 601. sure — tulisan / naskah kuno
bugis:sure_naskah
    rdf:type                      bugis:Nomina ;
    bugis:nomorEntri              601 ;
    bugis:aksaraLontaraq          "ᨔᨘᨑᨙ" ;
    bugis:bentukLatin             "sure" ;
    bugis:maknaIndonesia          "naskah, tulisan kuno, surat" ;
    bugis:maknaInggris            "manuscript, ancient script, letter" ;
    bugis:fonetik                 "/su.re/" ;
    bugis:silabel                 2 ;
    bugis:contohKalimat           "Sure lontara nalette pappasenna to riolo." ;
    bugis:contohKalimatTerjemahan "Naskah lontara menyimpan nasihat leluhur." ;
    bugis:jenisMorfologi          "kata dasar" ;
    bugis:tingkatFormalitas       "formal" ;
    bugis:frekuensiPenggunaan     "sedang" ;
    bugis:statusKata              "aktif" ;
    bugis:dialek                  "umum" ;
    bugis:sumber                  "OJED" ;
    bugis:berkaitanDengan         bugis:lontara ;
    bugis:berkaitanDengan         bugis:pappaseng ;
    bugis:termasukDomain          bugis:DomainSeniLoga .

