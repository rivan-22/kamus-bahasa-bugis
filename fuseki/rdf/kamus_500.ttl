# 400. baju — pakaian / baju
bugis:baju
    rdf:type                      bugis:Nomina ;
    bugis:nomorEntri              400 ;
    bugis:aksaraLontaraq          "ᨅᨍᨘ" ;
    bugis:bentukLatin             "baju" ;
    bugis:maknaIndonesia          "baju, pakaian, busana" ;
    bugis:maknaInggris            "shirt, clothing, garment" ;
    bugis:fonetik                 "/ba.ju/" ;
    bugis:silabel                 2 ;
    bugis:contohKalimat           "Baju waju madeceng napakai ri wettu bunting." ;
    bugis:contohKalimatTerjemahan "Baju dan sarung bagus ia pakai di waktu pernikahan." ;
    bugis:jenisMorfologi          "kata pinjaman (Melayu)" ;
    bugis:tingkatFormalitas       "formal" ;
    bugis:frekuensiPenggunaan     "tinggi" ;
    bugis:statusKata              "aktif" ;
    bugis:dialek                  "umum" ;
    bugis:sumber                  "OJED" ;
    bugis:diturunkanDari          bugis:akar_baju ;
    bugis:berkaitanDengan         bugis:waju ;
    bugis:termasukDomain          bugis:DomainBudaya .

