# =============================================================================
# DATA KAMUS BAHASA BUGIS — BATCH 9: 100 ENTRI (nomor 801–900)
# Domain: Peribahasa & Ungkapan Idiom | Perdagangan & Ekonomi Lanjutan |
#         Seni, Musik & Pertunjukan | Perhiasan & Busana Adat |
#         Sistem Sosial & Stratifikasi
# Semantic Web Course — Proyek Akhir
# Encoding: UTF-8
# Sumber: OJED (sealang.net/ojed), Wiktionary Bugis,
#         Matthes (1874) Boegineesch-Hollandsch Woordenboek,
#         Pelras (1996) The Bugis, Blackwell
# Aksara Lontaraq: Unicode Block Buginese U+1A00–U+1A1F
#   Verifikasi: r12a.github.io/scripts/bugi/bug.html (27-Apr-2026)
#   Konsonan: ᨀka ᨁga ᨂng ᨄpa ᨅba ᨆma ᨈta ᨉda ᨊna ᨌca ᨍja ᨎnya
#             ᨐya ᨑra ᨒla ᨓwa ᨔsa ᨖha | ᨕ vowel-carrier
#   Vokal: ᨗi ᨘu ᨙe(prebase) ᨚo
#   Coda omission: konsonan akhir suku kata tidak ditulis
# Audit duplikat: 0 kata bentrok dengan kamus.md (701 kata existing)
# =============================================================================

@prefix bugis:  <http://example.org/bugis#> .
@prefix rdf:    <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:   <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl:    <http://www.w3.org/2002/07/owl#> .
@prefix xsd:    <http://www.w3.org/2001/XMLSchema#> .


# =============================================================================
# AKAR KATA TAMBAHAN (Batch 9)
# =============================================================================

bugis:akar_resopa
    rdf:type bugis:AkarKata ;
    bugis:bentukLatinAkar    "resopa" ;
    bugis:aksaraLontaraqAkar "ᨑᨙᨔᨚᨄ" ;
    rdfs:comment "Akar: resopa — usaha keras, kerja tanpa kenal lelah (dasar peribahasa resopa temmangingngi)." .

bugis:akar_toddopuli
    rdf:type bugis:AkarKata ;
    bugis:bentukLatinAkar    "toddopuli" ;
    bugis:aksaraLontaraqAkar "ᨈᨚᨉᨚᨄᨘᨒᨗ" ;
    rdfs:comment "Akar: toddopuli — pantang mundur, teguh pendirian, karakter ksatria Bugis." .

bugis:akar_siturung
    rdf:type bugis:AkarKata ;
    bugis:bentukLatinAkar    "siturung" ;
    bugis:aksaraLontaraqAkar "ᨔᨗᨈᨘᨑᨘ" ;
    rdfs:comment "Akar: siturung — sepakat, seirama, sesuai/cocok bersama." .

bugis:akar_masero
    rdf:type bugis:AkarKata ;
    bugis:bentukLatinAkar    "masero" ;
    bugis:aksaraLontaraqAkar "ᨆᨔᨙᨑᨚ" ;
    rdfs:comment "Akar: masero — murah, terjangkau." .

bugis:akar_pakkarena
    rdf:type bugis:AkarKata ;
    bugis:bentukLatinAkar    "pakkarena" ;
    bugis:aksaraLontaraqAkar "ᨄᨀᨑᨙᨊ" ;
    rdfs:comment "Akar: pakkarena — tarian tradisional Bugis-Makassar." .

bugis:akar_salaka
    rdf:type bugis:AkarKata ;
    bugis:bentukLatinAkar    "salaka" ;
    bugis:aksaraLontaraqAkar "ᨔᨒᨀ" ;
    rdfs:comment "Akar: salaka — perak, perak murni." .

bugis:akar_maradeka
    rdf:type bugis:AkarKata ;
    bugis:bentukLatinAkar    "maradeka" ;
    bugis:aksaraLontaraqAkar "ᨆᨑᨉᨙᨀ" ;
