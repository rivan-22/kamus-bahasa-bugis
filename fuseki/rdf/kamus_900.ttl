    rdf:type                      bugis:Peribahasa ;
    bugis:nomorEntri              702 ;
    bugis:aksaraLontaraq          "ᨊᨕᨗᨕ ᨊᨒᨙᨆᨘ" ;
    bugis:bentukLatin             "naia nalempu" ;
    bugis:maknaIndonesia          "kejujuran itulah yang utama; yang benar itulah patokannya" ;
    bugis:maknaInggris            "that which is honest; truth is the standard" ;
    bugis:fonetik                 "/na.i.a na.lem.pu/" ;
    bugis:silabel                 5 ;
    bugis:contohKalimat           "Naia nalempu nainappa matu napopuang." ;
    bugis:contohKalimatTerjemahan "Kejujuran itulah yang pada akhirnya dimuliakan." ;
    bugis:jenisMorfologi          "frasa idiom" ;
    bugis:tingkatFormalitas       "formal" ;
    bugis:frekuensiPenggunaan     "sedang" ;
    bugis:statusKata              "aktif" ;
    bugis:dialek                  "umum" ;
    bugis:sumber                  "OJED" ;
    bugis:berkaitanDengan         bugis:malempu ;
    bugis:berkaitanDengan         bugis:pappaseng ;
    bugis:termasukDomain          bugis:DomainPeribahasa .

# 803. taro ada — menepati janji / sesuai kata
bugis:taro_ada
    rdf:type                      bugis:Peribahasa ;
    bugis:nomorEntri              703 ;
    bugis:aksaraLontaraq          "ᨈᨑᨚ ᨕᨉ" ;
    bugis:bentukLatin             "taro ada" ;
    bugis:maknaIndonesia          "menepati janji, sesuai kata perbuatan, integritas ucapan" ;
    bugis:maknaInggris            "to keep one's word, integrity of speech, walk the talk" ;
    bugis:fonetik                 "/ta.ro a.da/" ;
    bugis:silabel                 4 ;
    bugis:contohKalimat           "Taro ada taro gau, tau Ugi narapik." ;
    bugis:contohKalimatTerjemahan "Kata sesuai perbuatan, itulah yang dijaga orang Bugis." ;
    bugis:jenisMorfologi          "frasa idiom (taro + ada)" ;
    bugis:tingkatFormalitas       "formal" ;
    bugis:frekuensiPenggunaan     "tinggi" ;
    bugis:statusKata              "aktif" ;
