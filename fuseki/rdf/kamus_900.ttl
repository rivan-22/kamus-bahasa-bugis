# 801. resopa temmangingngi — kerja keras tak kenal lelah
bugis:resopa_temmangingngi
    rdf:type                      bugis:Peribahasa ;
    bugis:nomorEntri              701 ;
    bugis:aksaraLontaraq          "ᨑᨙᨔᨚᨄ ᨈᨙᨆᨂᨗᨂᨗ" ;
    bugis:bentukLatin             "resopa temmangingngi" ;
    bugis:maknaIndonesia          "kerja keras tak kenal lelah; hanya usaha gigih yang membuahkan hasil" ;
    bugis:maknaInggris            "tireless hard work; only diligent effort bears fruit (Bugis proverb)" ;
    bugis:fonetik                 "/re.so.pa tem.ma.ŋiŋ.ŋi/" ;
    bugis:silabel                 7 ;
    bugis:contohKalimat           "Resopa temmangingngi namalomo ri dalleq." ;
    bugis:contohKalimatTerjemahan "Kerja keras tak kenal lelah memudahkan rezeki." ;
    bugis:jenisMorfologi          "frasa idiom (peribahasa)" ;
    bugis:tingkatFormalitas       "formal" ;
    bugis:frekuensiPenggunaan     "tinggi" ;
    bugis:statusKata              "aktif" ;
    bugis:dialek                  "umum" ;
    bugis:sumber                  "OJED" ;
    bugis:diturunkanDari          bugis:akar_resopa ;
    bugis:berkaitanDengan         bugis:majjama ;
    bugis:berkaitanDengan         bugis:matinulu ;
    bugis:termasukDomain          bugis:DomainPeribahasa .

# 802. naia nalempu — kejujuran itulah / yang benar itulah
