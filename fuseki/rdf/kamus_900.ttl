    rdf:type bugis:AkarKata ;
    bugis:bentukLatinAkar    "pakeang" ;
    bugis:aksaraLontaraqAkar "ᨄᨀᨙᨕ" ;
    rdfs:comment "Akar: pakeang — pakaian, busana, sandang." .

bugis:akar_taro
