# --- NOMINA (Kata Benda) ---

# 301. arajang — benda pusaka kerajaan
bugis:arajang
    rdf:type                      bugis:Nomina ;
    bugis:nomorEntri              301 ;
    bugis:aksaraLontaraq          "ᨕᨑᨍᨙ" ;
    bugis:bentukLatin             "arajang" ;
    bugis:maknaIndonesia          "benda pusaka kerajaan, regalia" ;
    bugis:maknaInggris            "royal heirloom, regalia" ;
    bugis:fonetik                 "/a.ra.jaŋ/" ;
    bugis:silabel                 3 ;
    bugis:contohKalimat           "Arajang ritu pajagainna to mabbelai.\" ;" ;
    bugis:contohKalimatTerjemahan "Pusaka itu dijaga oleh para pengawal setia." ;
    bugis:jenisMorfologi          "kata dasar" ;
    bugis:tingkatFormalitas       "formal" ;
    bugis:frekuensiPenggunaan     "rendah" ;
    bugis:statusKata              "aktif" ;
    bugis:dialek                  "Bone" ;
    bugis:sumber                  "OJED" ;
    bugis:termasukDomain          bugis:DomainPemerintahan .

