# 201. ase — padi (gabah)
bugis:ase
    rdf:type                      bugis:Nomina ;
    bugis:nomorEntri              201 ;
    bugis:aksaraLontaraq          "ᨕᨔᨙ" ;
    bugis:bentukLatin             "ase" ;
    bugis:maknaIndonesia          "padi, gabah, beras dalam tangkai" ;
    bugis:maknaInggris            "rice paddy, unhusked rice, grain" ;
    bugis:fonetik                 "/a.se/" ;
    bugis:silabel                 2 ;
    bugis:contohKalimat           "Ase mappettu-i ri uma." ;
    bugis:contohKalimatTerjemahan "Padi sudah dipanen di sawah." ;
    bugis:jenisMorfologi          "kata dasar" ;
    bugis:tingkatFormalitas       "formal" ;
    bugis:frekuensiPenggunaan     "tinggi" ;
    bugis:statusKata              "aktif" ;
    bugis:dialek                  "umum" ;
    bugis:sumber                  "OJED" ;
    bugis:diturunkanDari          bugis:akar_ase ;
    bugis:berkaitanDengan         bugis:uma ;
    bugis:termasukDomain          bugis:DomainPertanian .

