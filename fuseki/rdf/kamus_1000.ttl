# =============================================================================
# DATA KAMUS BAHASA BUGIS — BATCH 10: 100 ENTRI (nomor 901–1000)
# Domain: Alam & Lingkungan | Pertanian & Perikanan | Kehidupan Spiritual |
#         Kekerabatan & Pernikahan | Pendidikan & Pengetahuan |
#         Emosi & Karakter | Bangunan & Arsitektur
# Semantic Web Course — Proyek Akhir
# Encoding: UTF-8
# Sumber: OJED (sealang.net/ojed), Wiktionary Bugis,
#         Matthes (1874) Boegineesch-Hollandsch Woordenboek,
#         Pelras (1996) The Bugis, Blackwell
# Aksara Lontaraq: Unicode Block Buginese U+1A00–U+1A1F
#   Verifikasi: r12a.github.io/scripts/bugi/bug.html (28-Apr-2026)
#   Konsonan: ᨀka ᨁga ᨂng ᨄpa ᨅba ᨆma ᨈta ᨉda ᨊna ᨌca ᨍja ᨎnya
#             ᨐya ᨑra ᨒla ᨓwa ᨔsa ᨖha | ᨕ vowel-carrier
#   Vokal: ᨗi ᨘu ᨙe(prebase) ᨚo
#   Coda omission: konsonan akhir suku kata tidak ditulis
# Audit duplikat: 0 kata bentrok dengan list_kata.md (entri existing)
# =============================================================================

@prefix bugis:  <http://example.org/bugis#> .
@prefix rdf:    <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:   <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl:    <http://www.w3.org/2002/07/owl#> .
@prefix xsd:    <http://www.w3.org/2001/XMLSchema#> .


# =============================================================================
# AKAR KATA TAMBAHAN (Batch 10)
# =============================================================================

bugis:akar_botto
    rdf:type bugis:AkarKata ;
    bugis:bentukLatinAkar    "botto" ;
    bugis:aksaraLontaraqAkar "ᨅᨚᨈᨚ" ;
    rdfs:comment "Akar: botto — bukit kecil, gundukan tanah." .

bugis:akar_uwae
    rdf:type bugis:AkarKata ;
    bugis:bentukLatinAkar    "uwae" ;
    bugis:aksaraLontaraqAkar "ᨕᨘᨓᨙ" ;
    rdfs:comment "Akar: uwae — air, cairan, sumber air (varian dialek wae)." .

bugis:akar_teddeng
    rdf:type bugis:AkarKata ;
    bugis:bentukLatinAkar    "teddeng" ;
    bugis:aksaraLontaraqAkar "ᨈᨙᨉᨙ" ;
    rdfs:comment "Akar: teddeng — turun, menurun, merendah." .

bugis:akar_paddisseng
    rdf:type bugis:AkarKata ;
    bugis:bentukLatinAkar    "paddisseng" ;
    bugis:aksaraLontaraqAkar "ᨄᨉᨗᨔᨙ" ;
    rdfs:comment "Akar: paddisseng — pengetahuan, ilmu, pemahaman." .

bugis:akar_palungang
    rdf:type bugis:AkarKata ;
    bugis:bentukLatinAkar    "palungang" ;
    bugis:aksaraLontaraqAkar "ᨄᨒᨘᨂ" ;
    rdfs:comment "Akar: palungang — tempat bernaung, pelindung." .

bugis:akar_lempu
    rdf:type bugis:AkarKata ;
    bugis:bentukLatinAkar    "lempu" ;
    bugis:aksaraLontaraqAkar "ᨒᨙᨆᨘ" ;
    rdfs:comment "Akar: lempu — jujur, lurus, benar." .

bugis:akar_getteng
    rdf:type bugis:AkarKata ;
    bugis:bentukLatinAkar    "getteng" ;
    bugis:aksaraLontaraqAkar "ᨁᨙᨈᨙ" ;
    rdfs:comment "Akar: getteng — teguh, kuat pendirian, tidak tergoyahkan." .

bugis:akar_warani
    rdf:type bugis:AkarKata ;
    bugis:bentukLatinAkar    "warani" ;
    bugis:aksaraLontaraqAkar "ᨓᨑᨊᨗ" ;
    rdfs:comment "Akar: warani — berani, pemberani, keberanian." .

bugis:akar_sappo
    rdf:type bugis:AkarKata ;
    bugis:bentukLatinAkar    "sappo" ;
    bugis:aksaraLontaraqAkar "ᨔᨄᨚ" ;
    rdfs:comment "Akar: sappo — pagar, pembatas, pelindung." .

bugis:akar_tanre
    rdf:type bugis:AkarKata ;
    bugis:bentukLatinAkar    "tanre" ;
    bugis:aksaraLontaraqAkar "ᨈᨊᨙ" ;
    rdfs:comment "Akar: tanre — tinggi, luhur, mulia." .


# =============================================================================
# ── DOMAIN A: ALAM & LINGKUNGAN (20 entri, 901–920) ─────────────────────────
