# 901. botto — bukit / gundukan tanah
bugis:botto
    rdf:type                      bugis:Nomina ;
    bugis:nomorEntri              901 ;
    bugis:aksaraLontaraq          "ᨅᨚᨈᨚ" ;
    bugis:bentukLatin             "botto" ;
    bugis:maknaIndonesia          "bukit kecil, gundukan tanah, dataran tinggi kecil" ;
    bugis:maknaInggris            "small hill, mound, hillock, elevated ground" ;
    bugis:fonetik                 "/bot.to/" ;
    bugis:silabel                 2 ;
    bugis:contohKalimat           "Monro-i ri botto napaisseng anakna." ;
    bugis:contohKalimatTerjemahan "Ia tinggal di bukit mengajari anaknya." ;
    bugis:jenisMorfologi          "kata dasar" ;
    bugis:tingkatFormalitas       "formal" ;
    bugis:frekuensiPenggunaan     "sedang" ;
    bugis:statusKata              "aktif" ;
    bugis:dialek                  "umum" ;
    bugis:sumber                  "OJED" ;
    bugis:diturunkanDari          bugis:akar_botto ;
    bugis:berkaitanDengan         bugis:tana ;
    bugis:berkaitanDengan         bugis:buttu ;
    bugis:termasukDomain          bugis:DomainGeografi .

