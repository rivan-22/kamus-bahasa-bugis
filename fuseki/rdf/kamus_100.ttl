# 31. ambo — ayah / bapak
bugis:ambo
    rdf:type                      bugis:Nomina ;
    bugis:nomorEntri              31 ;
    bugis:aksaraLontaraq          "ᨕᨆᨅᨚ" ;
    bugis:bentukLatin             "ambo" ;
    bugis:maknaIndonesia          "ayah, bapak" ;
    bugis:maknaInggris            "father, dad" ;
    bugis:fonetik                 "/am.bo/" ;
    bugis:silabel                 2 ;
    bugis:contohKalimat           "Amboku guru ri sekolah." ;
    bugis:contohKalimatTerjemahan "Ayahku guru di sekolah." ;
    bugis:jenisMorfologi          "kata dasar" ;
    bugis:tingkatFormalitas       "informal" ;
    bugis:frekuensiPenggunaan     "tinggi" ;
    bugis:statusKata              "aktif" ;
    bugis:dialek                  "umum" ;
    bugis:sumber                  "OJED" ;
    bugis:diturunkanDari          bugis:akar_ambo ;
    bugis:antonimDari             bugis:indo ;
    bugis:berkaitanDengan         bugis:ana ;
    bugis:termasukDomain          bugis:DomainKekerabatan .

