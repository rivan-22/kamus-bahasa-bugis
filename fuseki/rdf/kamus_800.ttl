# =============================================================================
# DATA TAMBAHAN KAMUS BAHASA BUGIS — 100 ENTRI RDF TURTLE
# Semantic Web Course — Proyek Akhir
# Domain: Kesehatan & Tubuh | Alam & Tumbuhan | Makanan & Kuliner |
#         Kata Kerja Lanjut | Kata Sifat Lanjut | Ritual & Adat |
#         Geografi & Tempat | Emosi & Karakter | Peribahasa | Campuran
# Encoding: UTF-8
# Sumber: OJED (sealang.net/ojed), Wiktionary Bugis
# Entri: 701–800 (melanjutkan dari kamus_700.ttl)
# =============================================================================

@prefix bugis:  <http://example.org/bugis#> .
@prefix rdf:    <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:   <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl:    <http://www.w3.org/2002/07/owl#> .
@prefix xsd:    <http://www.w3.org/2001/XMLSchema#> .


# =============================================================================
# DOMAIN SEMANTIK BARU
# =============================================================================

bugis:DomainKesehatan
    rdf:type        bugis:DomainSemantik ;
    bugis:namaDomain "kesehatan dan tubuh" ;
    rdfs:label      "Kesehatan dan Tubuh"@id ;
    rdfs:comment    "Kata-kata yang berkaitan dengan kesehatan, bagian tubuh, dan kondisi fisik." .

bugis:DomainKuliner
    rdf:type        bugis:DomainSemantik ;
    bugis:namaDomain "makanan dan kuliner" ;
    rdfs:label      "Makanan dan Kuliner"@id ;
    rdfs:comment    "Kata-kata yang berkaitan dengan makanan, minuman, bumbu, dan cara memasak khas Bugis." .

bugis:DomainGeografi
    rdf:type        bugis:DomainSemantik ;
    bugis:namaDomain "geografi dan tempat" ;
    rdfs:label      "Geografi dan Tempat"@id ;
    rdfs:comment    "Kata-kata yang berkaitan dengan nama tempat, bentang alam, dan fitur geografis." .

bugis:DomainRitual
    rdf:type        bugis:DomainSemantik ;
    bugis:namaDomain "ritual dan adat" ;
    rdfs:label      "Ritual dan Adat"@id ;
    rdfs:comment    "Kata-kata yang berkaitan dengan upacara adat, ritual keagamaan, dan kepercayaan Bugis." .

bugis:DomainFlora
    rdf:type        bugis:DomainSemantik ;
    bugis:namaDomain "flora dan tumbuhan" ;
    rdfs:label      "Flora dan Tumbuhan"@id ;
    rdfs:comment    "Kata-kata yang berkaitan dengan berbagai jenis tanaman, pohon, dan tumbuhan Sulawesi Selatan." .


# =============================================================================
# AKAR KATA BARU
# =============================================================================

bugis:akar_etto
    rdf:type                 bugis:AkarKata ;
    bugis:bentukLatinAkar    "etto" ;
    bugis:aksaraLontaraqAkar "ᨕᨙᨈᨚ" ;
    rdfs:comment             "Akar: etto — dada, bagian depan tubuh antara leher dan perut." .

bugis:akar_teppo
    rdf:type                 bugis:AkarKata ;
    bugis:bentukLatinAkar    "teppo" ;
    bugis:aksaraLontaraqAkar "ᨈᨙᨄᨚ" ;
    rdfs:comment             "Akar: teppo — lutut, persendian pada kaki." .

bugis:akar_pao
    rdf:type                 bugis:AkarKata ;
    bugis:bentukLatinAkar    "pao" ;
    bugis:aksaraLontaraqAkar "ᨄᨕᨚ" ;
    rdfs:comment             "Akar: pao — mangga, buah tropis manis." .

bugis:akar_tarru
    rdf:type                 bugis:AkarKata ;
    bugis:bentukLatinAkar    "tarru" ;
    bugis:aksaraLontaraqAkar "ᨈᨑᨘ" ;
    rdfs:comment             "Akar: tarru — tebu, tanaman penghasil gula." .

bugis:akar_sallo
    rdf:type                 bugis:AkarKata ;
    bugis:bentukLatinAkar    "sallo" ;
    bugis:aksaraLontaraqAkar "ᨔᨒᨚ" ;
    rdfs:comment             "Akar: sallo — anak sungai, aliran air kecil." .

bugis:akar_agang
    rdf:type                 bugis:AkarKata ;
    bugis:bentukLatinAkar    "agang" ;
    bugis:aksaraLontaraqAkar "ᨕᨁᨂ" ;
    rdfs:comment             "Akar: agang — teman, kawan, sahabat." .

bugis:akar_collo
    rdf:type                 bugis:AkarKata ;
    bugis:bentukLatinAkar    "collo" ;
    bugis:aksaraLontaraqAkar "ᨌᨚᨒᨚ" ;
    rdfs:comment             "Akar: collo — kuah kental, saus berbumbu." .

bugis:akar_lette
    rdf:type                 bugis:AkarKata ;
    bugis:bentukLatinAkar    "lette" ;
    bugis:aksaraLontaraqAkar "ᨒᨙᨈᨙ" ;
    rdfs:comment             "Akar: lette — jembatan, penghubung antara dua tepi." .

bugis:akar_langkana
    rdf:type                 bugis:AkarKata ;
    bugis:bentukLatinAkar    "langkana" ;
    bugis:aksaraLontaraqAkar "ᨒᨂᨀᨊ" ;
    rdfs:comment             "Akar: langkana — istana, tempat kediaman bangsawan." .

bugis:akar_paddinging
    rdf:type                 bugis:AkarKata ;
    bugis:bentukLatinAkar    "paddinging" ;
    bugis:aksaraLontaraqAkar "ᨄᨉᨗᨂᨗ" ;
    rdfs:comment             "Akar: paddinging — menggigil, gemetar kedinginan." .


