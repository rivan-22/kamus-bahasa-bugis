# 701. etto — dada / bagian depan tubuh
bugis:etto
    rdf:type                      bugis:Nomina ;
    bugis:nomorEntri              701 ;
    bugis:aksaraLontaraq          "ᨕᨙᨈᨚ" ;
    bugis:bentukLatin             "etto" ;
    bugis:maknaIndonesia          "dada, bagian depan tubuh antara leher dan perut" ;
    bugis:maknaInggris            "chest, breast, thorax" ;
    bugis:fonetik                 "/et.to/" ;
    bugis:silabel                 2 ;
    bugis:contohKalimat           "Maddara ri etto na nakiya ballasuji." ;
    bugis:contohKalimatTerjemahan "Dadanya tertusuk duri bambu." ;
    bugis:jenisMorfologi          "kata dasar" ;
    bugis:tingkatFormalitas       "informal" ;
    bugis:frekuensiPenggunaan     "sedang" ;
    bugis:statusKata              "aktif" ;
    bugis:dialek                  "umum" ;
    bugis:sumber                  "OJED" ;
    bugis:berkaitanDengan         bugis:ati ;
    bugis:termasukDomain          bugis:DomainKesehatan .

