# =============================================================================
# DATA KAMUS BAHASA BUGIS — 30 ENTRI RDF TURTLE
# Semantic Web Course — Proyek Akhir
# Format: Turtle (.ttl) — load ke Apache Jena Fuseki
# Encoding: UTF-8 (wajib untuk aksara Lontaraq)
# Sumber: OJED (sealang.net/ojed), Wiktionary Bugis
# =============================================================================

@prefix bugis:  <http://example.org/bugis#> .
@prefix rdf:    <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:   <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl:    <http://www.w3.org/2002/07/owl#> .
@prefix xsd:    <http://www.w3.org/2001/XMLSchema#> .


# =============================================================================
# AKAR KATA (digunakan sebagai referensi oleh entri-entri di bawah)
# =============================================================================

bugis:akar_tana
    rdf:type                 bugis:AkarKata ;
    bugis:bentukLatinAkar    "tana" ;
    bugis:aksaraLontaraqAkar "ᨈᨊ" ;
    rdfs:comment             "Akar: tana — tanah, negeri." .

bugis:akar_tau
    rdf:type                 bugis:AkarKata ;
    bugis:bentukLatinAkar    "tau" ;
    bugis:aksaraLontaraqAkar "ᨈᨕᨘ" ;
    rdfs:comment             "Akar: tau — orang, manusia." .

bugis:akar_ati
    rdf:type                 bugis:AkarKata ;
    bugis:bentukLatinAkar    "ati" ;
    bugis:aksaraLontaraqAkar "ᨕᨈᨗ" ;
    rdfs:comment             "Akar: ati — hati, perasaan batin." .

bugis:akar_bicara
    rdf:type                 bugis:AkarKata ;
    bugis:bentukLatinAkar    "bicara" ;
    bugis:aksaraLontaraqAkar "ᨅᨗᨌᨑ" ;
    rdfs:comment             "Akar: bicara — tutur, ucap." .

bugis:akar_esso
    rdf:type                 bugis:AkarKata ;
    bugis:bentukLatinAkar    "esso" ;
    bugis:aksaraLontaraqAkar "ᨕᨙᨔᨚ" ;
    rdfs:comment             "Akar: esso — matahari, siang hari." .

bugis:akar_wenni
    rdf:type                 bugis:AkarKata ;
    bugis:bentukLatinAkar    "wenni" ;
    bugis:aksaraLontaraqAkar "ᨓᨙᨂᨗ" ;
    rdfs:comment             "Akar: wenni — malam." .

bugis:akar_wae
    rdf:type                 bugis:AkarKata ;
    bugis:bentukLatinAkar    "wae" ;
    bugis:aksaraLontaraqAkar "ᨓᨕᨙ" ;
    rdfs:comment             "Akar: wae — air." .

bugis:akar_api
    rdf:type                 bugis:AkarKata ;
    bugis:bentukLatinAkar    "api" ;
    bugis:aksaraLontaraqAkar "ᨕᨄᨗ" ;
    rdfs:comment             "Akar: api — api." .

bugis:akar_lomo
    rdf:type                 bugis:AkarKata ;
    bugis:bentukLatinAkar    "lomo" ;
    bugis:aksaraLontaraqAkar "ᨒᨚᨆᨚ" ;
    rdfs:comment             "Akar: lomo — mudah, ringan." .

bugis:akar_sussa
    rdf:type                 bugis:AkarKata ;
    bugis:bentukLatinAkar    "sussa" ;
    bugis:aksaraLontaraqAkar "ᨔᨘᨔ" ;
    rdfs:comment             "Akar: sussa — susah, sulit." .

bugis:akar_deceng
    rdf:type                 bugis:AkarKata ;
    bugis:bentukLatinAkar    "deceng" ;
    bugis:aksaraLontaraqAkar "ᨉᨙᨌᨙ" ;
    rdfs:comment             "Akar: deceng — baik, bagus." .

bugis:akar_ja
    rdf:type                 bugis:AkarKata ;
    bugis:bentukLatinAkar    "ja" ;
    bugis:aksaraLontaraqAkar "ᨍ" ;
    rdfs:comment             "Akar: ja — buruk, jelek." .

bugis:akar_lao
    rdf:type                 bugis:AkarKata ;
    bugis:bentukLatinAkar    "lao" ;
    bugis:aksaraLontaraqAkar "ᨒᨕᨚ" ;
    rdfs:comment             "Akar: lao — pergi." .

bugis:akar_mai
    rdf:type                 bugis:AkarKata ;
    bugis:bentukLatinAkar    "mai" ;
    bugis:aksaraLontaraqAkar "ᨆᨕᨗ" ;
