# 1. tana — tanah / negeri
bugis:tana
    rdf:type                      bugis:Nomina ;
    bugis:nomorEntri              1 ;
    bugis:aksaraLontaraq          "ᨈᨊ" ;
    bugis:bentukLatin             "tana" ;
    bugis:maknaIndonesia          "tanah, negeri, wilayah" ;
    bugis:maknaInggris            "land, country, territory" ;
    bugis:fonetik                 "/ta.na/" ;
    bugis:silabel                 2 ;
    bugis:contohKalimat           "Tana Ugi nenniya tana Mangkasara silaong matu." ;
    bugis:contohKalimatTerjemahan "Tanah Bugis dan tanah Makassar bersatu selalu." ;
    bugis:jenisMorfologi          "kata dasar" ;
    bugis:tingkatFormalitas       "formal" ;
    bugis:frekuensiPenggunaan     "tinggi" ;
    bugis:statusKata              "aktif" ;
    bugis:dialek                  "umum" ;
    bugis:sumber                  "OJED" ;
    bugis:diturunkanDari          bugis:akar_tana ;
    bugis:termasukDomain          bugis:DomainGeografi .

