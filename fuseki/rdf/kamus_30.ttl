# =============================================================================
# RINGKASAN RELASI SEMANTIK
# (untuk referensi dan verifikasi)
#
# SINONIM:
#   pinasa  ↔ nawa
#   mabbicara ↔ mappau
#   runtu   ↔ engka
#   madeceng ↔ malempu
#
# ANTONIM:
#   esso    ↔ wenni
#   wae     ↔ api
#   malomo  ↔ masussa
#   madeceng ↔ maja
#   malempu ↔ malobong
#   maloppe ↔ macekke
#   matasa  ↔ maddara_ota
#   mallao  ↔ runtu / monro
#   engka   ↔ dena
#   melo    ↔ dena_melo
#
# AKAR KATA:
#   tana    ← akar_tana
#   tau     ← akar_tau
#   ati     ← akar_ati
#   pinasa  ← akar_ati
#   esso    ← akar_esso
#   wenni   ← akar_wenni
#   wae     ← akar_wae
#   api     ← akar_api
#   ugi     ← akar_ogi
#   mabbicara ← akar_bicara
#   mallao  ← akar_lao
#   runtu   ← akar_mai
#   malomo  ← akar_lomo
#   masussa ← akar_sussa
#   madeceng ← akar_deceng
#   maja    ← akar_ja
# =============================================================================
