# 101. mawarani — berani / pemberani
bugis:mawarani
    rdf:type                      bugis:Adjektiva ;
    bugis:nomorEntri              101 ;
    bugis:aksaraLontaraq          "ᨆᨓᨑᨊᨗ" ;
    bugis:bentukLatin             "mawarani" ;
    bugis:maknaIndonesia          "berani, pemberani, tidak takut" ;
    bugis:maknaInggris            "brave, courageous, fearless" ;
    bugis:fonetik                 "/ma.wa.ra.ni/" ;
    bugis:silabel                 4 ;
    bugis:contohKalimat           "Mawarani-i tau narekko naitai masalah." ;
    bugis:contohKalimatTerjemahan "Ia berani ketika menghadapi masalah." ;
    bugis:jenisMorfologi          "berimbuhan (ma- + warani)" ;
    bugis:tingkatFormalitas       "formal" ;
    bugis:frekuensiPenggunaan     "tinggi" ;
    bugis:statusKata              "aktif" ;
    bugis:dialek                  "umum" ;
    bugis:sumber                  "OJED" ;
    bugis:diturunkanDari          bugis:akar_berani ;
    bugis:menggunakanPrefiks      bugis:Prefiks_ma ;
    bugis:antonimDari             bugis:matakku ;
    bugis:termasukDomain          bugis:DomainEmosi .

